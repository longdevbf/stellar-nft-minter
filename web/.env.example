# Copy file nay thanh .env.local roi dien gia tri that. .env.local bi gitignore.

# --- Bi mat: CHI dung o server (app/api/**). ---
# KHONG dat tien to NEXT_PUBLIC_ cho bien nay. Next.js nhung moi bien co tien to
# do vao bundle trinh duyet, tuc la lo JWT cho bat ky ai mo DevTools.
PINATA_JWT=

# --- Cong khai: an toan khi lo ra trinh duyet. ---
NEXT_PUBLIC_PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/
NEXT_PUBLIC_CONTRACT_ID=
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
